{
  "name": "political-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:api": "vitest run --config vitest.api.config.js",
    "seed:elections": "node scripts/seed-elections.mjs",
    "seed:organisations": "node scripts/seed-organisations.mjs",
    "data:build": "node scripts/generateAssociationsJson.mjs",
    "blog:automate": "node scripts/run-blog-automation.mjs",
    "blog:approve": "node scripts/approve-blog-post.mjs",
    "blog:publish": "node scripts/publish-blog-post.mjs",
    "verify:prod:headers": "powershell -ExecutionPolicy Bypass -File scripts/verify-prod-headers.ps1",
    "verify:prerender": "powershell -ExecutionPolicy Bypass -File scripts/verify-prerender-output.ps1",
    "verify:prod:seo": "powershell -ExecutionPolicy Bypass -File scripts/verify-prod-seo-html.ps1"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/supabase-js": "^2.99.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.16",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.1.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
