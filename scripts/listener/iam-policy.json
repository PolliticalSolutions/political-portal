{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SQSJobQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:eu-west-2:561375865143:ps-upload-api-prod-process-queue"
    },
    {
      "Sid": "S3ReadUploads",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:HeadObject"
      ],
      "Resource": "arn:aws:s3:::ps-upload-api-prod-uploads-561375865143/uploads/*"
    },
    {
      "Sid": "S3WriteOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::ps-upload-api-prod-uploads-561375865143/outputs/*"
    },
    {
      "Sid": "DynamoDBJobs",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-2:561375865143:table/ps-upload-api-prod-jobs"
    },
    {
      "Sid": "SESSendEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*"
    }
  ]
}
